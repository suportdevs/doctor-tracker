# Local development (npm run dev). Start MongoDB first: `docker compose up -d mongo` (port 27018).
MONGO_URI=mongodb://127.0.0.1:27018/doctor_tracker
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:3000
# Seed demo data automatically when the database is empty.
SEED_ON_START=true
