# Used by docker-compose.yml (copy to .env). Every value has a safe local default.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
MONGO_PORT=27018
# Seeds the demo admin, doctors and patients when the database is empty.
SEED_ON_START=true
