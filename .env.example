# Used by docker-compose.yml (copy to .env). Every value has a safe local default.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
MONGO_PORT=27018
# Seeds the demo admin, doctors, patients and website pages when the database is empty.
SEED_ON_START=true

# Email for password reset links and 2FA codes. Leave SMTP_HOST empty to run without email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Doctor Tracker <no-reply@doctortracker.dev>"
# Demo fallback: with no SMTP, show reset links / codes on screen. Set to false in production!
MAIL_PREVIEW=true
